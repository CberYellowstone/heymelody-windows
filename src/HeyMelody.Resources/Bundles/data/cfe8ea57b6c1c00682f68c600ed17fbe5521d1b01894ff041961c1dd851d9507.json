{
  "template": [
    {
      "type": "card-template",
      "attr": {
        "entry": "gadget"
      },
      "events": {
        "click": "clickCard"
      },
      "children": [
        {
          "type": "widget",
          "attr": {
            "type": "progress",
            "min": "{{min}}",
            "max": "{{max}}",
            "value": "{{power}}",
            "autoplay": "{{autoPlay}}"
          },
          "children": [
            {
              "type": "image",
              "attr": {
                "src": "{{headsetImg}}"
              },
              "classList": [
                "middle"
              ]
            },
            {
              "type": "image",
              "attr": {
                "src": "{{chargeImg}}"
              },
              "classList": [
                "bottom"
              ],
              "shown": "{{showCharge}}"
            },
            {
              "type": "text",
              "attr": {},
              "classList": [
                "bottom"
              ],
              "shown": "{{showPowerTxt}}",
              "children": [
                {
                  "type": "span",
                  "attr": {
                    "value": "{{powerTxt}}"
                  },
                  "classList": [
                    "xxs-font"
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "data": {
    "min": 0,
    "max": 100,
    "power": 0,
    "powerTxt": "--",
    "showPowerTxt": true,
    "chargeImg": "assets/images/headset_charge.svg",
    "showCharge": false,
    "autoPlay": false,
    "headsetImg": "assets/images/headset_left_right.svg"
  },
  "actions": {},
  "styles": {},
  "apiVersion": {}
}