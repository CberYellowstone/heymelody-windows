<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>HeyMelody.Host</AssemblyName>
    <Version>0.9.1</Version>
    <ApplicationIcon>../HeyMelody.App/Assets/HeyMelody.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HeyMelody.Host.Tests" />
    <EmbeddedResource Include="Assets/hearing_enhancement_audition.wav" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <AvaloniaResource Include="../HeyMelody.App/Assets/HeyMelody.ico" Link="Assets/HeyMelody.ico" />
    <!-- The tray menu is drawn by Avalonia, so it shares the UI rendering and typography setup. -->
    <Compile Include="../HeyMelody.App/RenderingSetup.cs" Link="Shared/RenderingSetup.cs" />
    <Compile Include="../HeyMelody.App/Typography.cs" Link="Shared/Typography.cs" />
    <ProjectReference Include="../HeyMelody.Windows/HeyMelody.Windows.csproj" />
    <ProjectReference Include="../HeyMelody.Daily/HeyMelody.Daily.csproj" />
    <ProjectReference Include="../HeyMelody.Contracts/HeyMelody.Contracts.csproj" />
    <ProjectReference Include="../HeyMelody.Resources/HeyMelody.Resources.csproj" />
    <ProjectReference Include="../HeyMelody.Calibration/HeyMelody.Calibration.csproj" />
  </ItemGroup>
</Project>
