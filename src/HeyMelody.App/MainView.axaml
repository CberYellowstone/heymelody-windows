<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:vm="clr-namespace:HeyMelodyWindows.App;assembly=HeyMelody.Client"
             xmlns:contracts="clr-namespace:HeyMelodyWindows.App;assembly=HeyMelody.Contracts"
             xmlns:local="clr-namespace:HeyMelodyWindows.App"
             x:Class="HeyMelodyWindows.App.MainView" x:DataType="vm:MainViewModel"
             Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
  <UserControl.Resources>
    <local:DeviceIconVisualConverter x:Key="DeviceIconVisualConverter" />
    <ControlTheme x:Key="DeviceCardTheme" TargetType="ListBoxItem">
      <Setter Property="Width" Value="300" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="CardBorder" Padding="{TemplateBinding Padding}"
                  TemplatedControl.IsTemplateFocusTarget="True"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
      </Style>
      <Style Selector="^:focus-visible">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.5" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="fa|FASettingsExpander">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="ListBox#DevicePicker">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBlock.setting-label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="MainLayout" RowDefinitions="*,Auto">
    <Grid x:Name="DeviceArea" ColumnDefinitions="*,500" Margin="24,12,24,0">
      <Grid x:Name="HeroPanel" Margin="8,0,32,0" RowDefinitions="*,Auto">
        <local:ProductArtwork x:Name="HeroArt" Margin="0,16" MaxWidth="600" MaxHeight="520"
                              VerticalAlignment="Center" HorizontalAlignment="Stretch" />
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,32" Spacing="6">
          <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Name="HeroCaption" Text="耳机外观" Classes="caption" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="ControlScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,18,8,24" Spacing="0">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Subtitle}" Classes="muted" Margin="0,7,0,0" />
            </StackPanel>
            <Button x:Name="AppSettingsButton" Grid.Column="1" Classes="icon" Click="AppSettings_Click" VerticalAlignment="Top"
                    IsEnabled="{Binding CanManageDevices}"
                    Margin="8,3,0,0" ToolTip.Tip="应用设置" AutomationProperties.Name="应用设置">
              <fa:FASymbolIcon Symbol="Settings" FontSize="18" />
            </Button>
          </Grid>
          <Grid ColumnDefinitions="*,*" Margin="0,0,0,16">
            <Button Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}"
                    IsEnabled="{Binding CanConnect}" Classes="accent" HorizontalAlignment="Left" />
            <Button Grid.Column="1" Content="刷新状态" Command="{Binding RefreshStateCommand}"
                    IsEnabled="{Binding CanRefreshState}" HorizontalAlignment="Right" />
          </Grid>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding HasActivity}" Height="3" Margin="0,0,0,12" />
          <fa:FAInfoBar x:Name="PlatformNotice" Severity="Informational" IsClosable="False" IsOpen="False" IsVisible="False"
                        Title="此平台的蓝牙后台尚未实现" Message="可以预览界面；真实耳机控制目前支持 Windows。" Margin="0,0,0,12" />
          <fa:FAInfoBar Severity="Warning" IsClosable="False" IsOpen="{Binding StatusWarning}" IsVisible="{Binding StatusWarning}"
                        Message="{Binding Status}" Margin="0,0,0,12" />
          <fa:FAInfoBar Severity="Informational" IsClosable="False" IsOpen="{Binding HasWarnings}" IsVisible="{Binding HasWarnings}"
                        Title="部分状态尚未读取" Message="{Binding WarningsText}" Margin="0,0,0,12" />
          <Border Margin="0,0,0,16" Padding="18,16" CornerRadius="6"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,*,*">
              <StackPanel Spacing="4">
                <TextBlock Text="左耳" Classes="caption" />
                <TextBlock Text="{Binding LeftBatteryText}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LeftChargeText}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="右耳" Classes="caption" />
                <TextBlock Text="{Binding RightBatteryText}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RightChargeText}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="充电盒" Classes="caption" />
                <TextBlock Text="{Binding CaseBatteryText}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CaseChargeText}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <fa:FASettingsExpander Header="降噪" Description="调整你听见的环境声音" IsExpanded="True">
            <fa:FASettingsExpander.IconSource><fa:FASymbolIconSource Symbol="Audio" /></fa:FASettingsExpander.IconSource>
            <local:AncModeSelector />
          </fa:FASettingsExpander>
          <fa:FASettingsExpander x:Name="EqualizerPanel" Header="均衡器" Description="预设与自定义 EQ" IsExpanded="True">
            <fa:FASettingsExpander.IconSource><fa:FASymbolIconSource Symbol="MusicInfo" /></fa:FASettingsExpander.IconSource>
            <Border Padding="20,16">
              <StackPanel Spacing="12">
                <local:EqualizerChoiceView />
                <TextBlock Text="{Binding EqHint}" Classes="muted" FontSize="12" />
                <TextBox x:Name="EqNameEditor" Text="{Binding EqName, Mode=TwoWay}" MaxLength="30" PlaceholderText="均衡器名称"
                         IsEnabled="{Binding CanEditEq}" AutomationProperties.Name="均衡器名称" />
                <ItemsControl x:Name="BandEditor" ItemsSource="{Binding Bands}" IsEnabled="{Binding CanEditEq}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EqBandViewModel">
                      <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding GainLabel}" FontSize="11" HorizontalAlignment="Center" />
                        <Slider Orientation="Vertical" Height="124" Width="32" Minimum="{Binding Minimum}"
                                Maximum="{Binding Maximum}" Value="{Binding Gain, Mode=TwoWay}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="{Binding FrequencyHz, StringFormat='{}{0} Hz 增益'}" />
                        <TextBlock Text="{Binding FrequencyLabel}" FontSize="11" HorizontalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding EqDirtyText}" Classes="caption" />
                <WrapPanel Orientation="Horizontal">
                  <Button Content="恢复当前" Command="{Binding ResetEqCommand}" Margin="0,0,8,4" />
                  <Button Content="保存并启用" Command="{Binding SaveEqCommand}" Classes="accent" Margin="0,0,0,4" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </fa:FASettingsExpander>
          <ItemsControl x:Name="FeatureSectionsView" ItemsSource="{Binding FeatureSections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FeatureSectionViewModel">
                <local:FeatureSectionView />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <fa:FASettingsExpander Header="黄金听感" Description="选择已有配置，或建立适合自己的听感">
            <Border Padding="20,16">
              <StackPanel Spacing="12">
                <ComboBox x:Name="HearingProfileCombo" ItemsSource="{Binding HearingProfiles}"
                          SelectedItem="{Binding SelectedHearingProfile, Mode=OneWay}" IsEnabled="{Binding CanSelectHearingProfile}"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="黄金听感配置">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="contracts:UiHearingProfile"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="设置黄金听感" Click="HearingSetup_Click" IsEnabled="{Binding CanSetupHearing}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </fa:FASettingsExpander>
          <fa:FASettingsExpanderItem Content="耳塞贴合度测试" Description="检查两耳的佩戴贴合度">
            <fa:FASettingsExpanderItem.Footer>
              <Button Content="开始测试" Click="FitTest_Click" IsEnabled="{Binding CanFitTest}" />
            </fa:FASettingsExpanderItem.Footer>
          </fa:FASettingsExpanderItem>
          <fa:FASettingsExpander x:Name="DeviceInfoPanel" Header="设备信息" Description="型号与固件">
            <fa:FASettingsExpander.IconSource><fa:FASymbolIconSource Symbol="ContactInfo" /></fa:FASettingsExpander.IconSource>
            <Border Padding="20,16">
              <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <TextBlock Text="设备名称" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="产品编号" Classes="muted" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProductId, TargetNullValue=—}" />
                <TextBlock Grid.Row="2" Text="固件版本" Classes="muted" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Firmware, TargetNullValue=—}" />
              </Grid>
            </Border>
          </fa:FASettingsExpander>
          <Expander Header="操作记录" Margin="0,8,0,0" HorizontalAlignment="Stretch">
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     MaxHeight="200" FontSize="12" AutomationProperties.Name="操作记录" />
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border x:Name="DeviceBar" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="20,8">
      <ScrollViewer x:Name="DeviceBarScroll" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
        <Border x:Name="DeviceStripPadding" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel x:Name="DeviceStrip" Orientation="Horizontal" Spacing="8" MinHeight="64">
            <Grid>
              <ListBox x:Name="DevicePicker" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=OneWay}"
                       ItemContainerTheme="{StaticResource DeviceCardTheme}"
                       SelectionChanged="Device_SelectionChanged" IsEnabled="{Binding CanRefreshDevices}"
                       MinHeight="64" AutoScrollToSelectedItem="False"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="设备切换">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="contracts:UiDevice">
                    <Grid x:Name="DeviceCardContent" ColumnDefinitions="32,Auto" ColumnSpacing="12"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                      <local:DeviceIconView x:Name="DeviceIcon" Width="28" Height="28" VerticalAlignment="Center">
                        <local:DeviceIconView.Visual>
                          <MultiBinding Converter="{StaticResource DeviceIconVisualConverter}">
                            <Binding Path="." />
                            <Binding Path="VisualCatalog" RelativeSource="{RelativeSource AncestorType={x:Type local:MainView}}" />
                            <Binding Path="VisualCatalog.Revision" RelativeSource="{RelativeSource AncestorType={x:Type local:MainView}}" />
                          </MultiBinding>
                        </local:DeviceIconView.Visual>
                      </local:DeviceIconView>
                      <StackPanel x:Name="DeviceText" Grid.Column="1" Spacing="4" MaxWidth="220">
                        <TextBlock x:Name="DeviceNameText" Text="{Binding Name}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                        <TextBlock Text="已配对" Classes="caption" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="EmptyDevicesText" Text="暂无已配对设备"
                         IsVisible="{Binding !HasDevices}" Classes="muted" VerticalAlignment="Center" Margin="8,0" />
            </Grid>
            <Border x:Name="AddDeviceHost" VerticalAlignment="Center">
              <Button x:Name="AddDeviceButton" Width="64" Height="64" Click="AddDevice_Click"
                      IsEnabled="{Binding !Closing}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      ToolTip.Tip="添加设备" AutomationProperties.Name="添加设备">
                <fa:FASymbolIcon Symbol="Add" FontSize="24" />
              </Button>
            </Border>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
