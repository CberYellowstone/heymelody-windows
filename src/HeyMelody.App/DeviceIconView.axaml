<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HeyMelodyWindows.App.DeviceIconView"
             x:Name="IconHost">
  <ContentPresenter x:Name="VisualPresenter"
                    Content="{Binding Visual, ElementName=IconHost}"
                    ContentTemplate="{Binding VisualTemplate, ElementName=IconHost}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
</UserControl>
