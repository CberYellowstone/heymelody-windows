<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <AssemblyName>HeyMelody</AssemblyName>
    <RootNamespace>HeyMelodyWindows.App</RootNamespace>
    <Version>0.7.0</Version>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/HeyMelody.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <ProjectReference Include="../HeyMelody.Client/HeyMelody.Client.csproj" />
    <AvaloniaResource Include="Assets/**" />
    <InternalsVisibleTo Include="HeyMelody.App.Tests" />
  </ItemGroup>
</Project>
