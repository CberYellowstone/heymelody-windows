<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <AssemblyName>HeyMelody</AssemblyName>
    <RootNamespace>HeyMelodyWindows.App</RootNamespace>
    <Version>0.5.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/HeyMelody.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/HeyMelody.ico"/><Resource Include="Assets/HeyMelody.png"/></ItemGroup>
</Project>
