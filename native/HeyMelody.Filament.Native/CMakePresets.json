{
  "version": 4,
  "configurePresets": [
    { "name": "base", "hidden": true, "generator": "Ninja", "binaryDir": "${sourceDir}/../../artifacts/filament/build/${presetName}", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "HM_FILAMENT_SOURCE": "$env{HEYMELODY_FILAMENT_SOURCE}" } },
    { "name": "win-x64", "inherits": "base", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }, "cacheVariables": { "HM_RUNTIME_IDENTIFIER": "win-x64" } },
    { "name": "win-arm64", "inherits": "base", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }, "cacheVariables": { "HM_RUNTIME_IDENTIFIER": "win-arm64", "CMAKE_SYSTEM_NAME": "Windows", "CMAKE_SYSTEM_PROCESSOR": "ARM64", "DIST_ARCH": "arm64" } },
    { "name": "osx-arm64", "inherits": "base", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }, "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64", "HM_RUNTIME_IDENTIFIER": "osx-arm64" } },
    { "name": "osx-x64", "inherits": "base", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }, "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "x86_64", "HM_RUNTIME_IDENTIFIER": "osx-x64" } },
    { "name": "linux-x64", "inherits": "base", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }, "cacheVariables": { "HM_RUNTIME_IDENTIFIER": "linux-x64" } },
    { "name": "linux-arm64", "inherits": "base", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }, "cacheVariables": { "HM_RUNTIME_IDENTIFIER": "linux-arm64" } }
  ],
  "buildPresets": [
    { "name": "win-x64", "configurePreset": "win-x64", "targets": ["HeyMelody.Filament.Native", "hm_filament_probe", "hm_filament_smoke"] },
    { "name": "win-arm64", "configurePreset": "win-arm64", "targets": ["HeyMelody.Filament.Native", "hm_filament_probe", "hm_filament_smoke"] },
    { "name": "osx-arm64", "configurePreset": "osx-arm64", "targets": ["HeyMelody.Filament.Native", "hm_filament_probe", "hm_filament_smoke"] },
    { "name": "osx-x64", "configurePreset": "osx-x64", "targets": ["HeyMelody.Filament.Native", "hm_filament_probe", "hm_filament_smoke"] },
    { "name": "linux-x64", "configurePreset": "linux-x64", "targets": ["HeyMelody.Filament.Native", "hm_filament_probe", "hm_filament_smoke"] },
    { "name": "linux-arm64", "configurePreset": "linux-arm64", "targets": ["HeyMelody.Filament.Native", "hm_filament_probe", "hm_filament_smoke"] }
  ]
}
